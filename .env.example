# Copy to .env and replace EVERY value before use. Never commit .env.

# --- Database ---
DB_NAME=tourist_permit
DB_USERNAME=tourist_permit
DB_PASSWORD=change-me-strong-db-password
# Host port for local tools (bound to 127.0.0.1 only)
DB_HOST_PORT=5432

# --- Security ---
# HMAC-SHA256 key for JWT signing. Base64, at least 32 bytes of randomness:
#   openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_BASE64_SECRET_AT_LEAST_32_BYTES
# AES-256 key protecting stored QR tokens. Base64 of exactly 32 bytes:
#   openssl rand -base64 32
QR_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# --- Application ---
# Public URL of the frontend; used inside QR codes as <APP_BASE_URL>/verify/<token>
APP_BASE_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081
FRONTEND_PORT=8081
# HTTPS port; served only when certs/tls.crt + certs/tls.key exist (phone cameras need HTTPS)
FRONTEND_HTTPS_PORT=8443
# prod | dev  (dev seeds SAMPLE permit areas — never use dev in production)
SPRING_PROFILES_ACTIVE=prod
API_DOCS_ENABLED=false
VERIFICATION_LOCATION_ENABLED=false

# --- File storage ---
# local = Docker volume (single host). s3 = S3-compatible bucket, needed when running several
# backend instances on different hosts. Local S3 for testing: docker compose --profile s3 up -d
STORAGE_TYPE=local
# S3_ENDPOINT=http://seaweedfs:8333
# S3_BUCKET=yatrapass-uploads
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Driving routes (default start point) ---
ROUTING_ORIGIN_LABEL=Pokhara
ROUTING_ORIGIN_LAT=28.2096
ROUTING_ORIGIN_LNG=83.9856

# --- eSewa online payments ---
# Unset = profile default (dev: on, using eSewa's public UAT test merchant; prod: off).
# Production: ESEWA_ENABLED=true, your merchant ESEWA_PRODUCT_CODE / ESEWA_SECRET_KEY and the live URLs
#   ESEWA_FORM_URL=https://epay.esewa.com.np/api/epay/main/v2/form
#   ESEWA_STATUS_URL=https://epay.esewa.com.np/api/epay/transaction/status/
# ESEWA_ENABLED=true
ESEWA_PRODUCT_CODE=EPAYTEST
# ESEWA_SECRET_KEY=

# --- Notifications ---
# Email: the bundled Mailpit catches all mail (UI: http://localhost:8025). Use a real SMTP relay in production.
MAIL_ENABLED=true
MAIL_FROM=YatraPass <no-reply@yatrapass.local>
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
# SMS: none | log (dev: logs a masked number) | sparrow (Sparrow SMS, Nepali numbers)
SMS_PROVIDER=log
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=
# Days before expiry to remind tourists
PERMIT_EXPIRY_REMINDER_DAYS=3,1

# --- Optional bootstrap accounts (created once at startup if set) ---
# Leave blank in production after the first admin exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_OFFICER_EMAIL=
SEED_OFFICER_PASSWORD=
