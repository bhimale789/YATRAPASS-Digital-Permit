# Enabled at container start by 30-enable-https.sh only when a certificate is mounted at
# /etc/nginx/certs/tls.crt + tls.key. Browsers require HTTPS for camera access (QR scanner).
server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:5m;

    include /etc/nginx/snippets/app.conf;
}
